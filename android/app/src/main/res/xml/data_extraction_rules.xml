<?xml version="1.0" encoding="utf-8"?>
<!-- 2 Oct 2026: nothing from this app goes into Google cloud backup or a phone-to-phone
     transfer. The app keeps a sign-in and an offline copy of registers and student names
     on the phone; those must stay on this phone only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
